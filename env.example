# ── Azure AI Vision (Face Detection) ──────────────────────────────────────────
AZURE_VISION_ENDPOINT=https://YOUR_RESOURCE.cognitiveservices.azure.com/
AZURE_VISION_KEY=your_vision_key_here

# ── Azure OpenAI ───────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_KEY=your_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ── Azure AI Search (RAG) ──────────────────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://YOUR_RESOURCE.search.windows.net
AZURE_SEARCH_KEY=your_search_key_here
AZURE_SEARCH_INDEX=ostim-index
